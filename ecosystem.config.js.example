// pm2 管理 MongoShake collector。
// 掛載到 container 的 /opt/mongoshake/pm2/ecosystem.config.js。
// conf 讀 /opt/mongoshake/conf/（entrypoint 由 conf.tpl/ envsubst 產生）。
// collector 是 Go binary，interpreter 設 'none' 讓 pm2 直接 exec。
const mk = (name, conf) => ({
  name,
  script: '/opt/mongoshake/collector',
  args: ['-conf=/opt/mongoshake/conf/' + conf, '-verbose=0'],
  interpreter: 'none',
  cwd: '/opt/mongoshake',
  exec_mode: 'fork',
  instances: 1,
  autorestart: true,
  // 起來不到 30 秒就死 = 設定錯誤，重試 3 次後放棄，避免無窮重啟蓋掉錯誤訊息
  min_uptime: '30s',
  max_restarts: 3,
  exp_backoff_restart_delay: 2000,
  kill_timeout: 30000,        // 給 checkpoint flush 的時間
  stop_exit_codes: [0],
  merge_logs: true,
  time: true,
  out_file: '/opt/mongoshake/logs/' + name + '.out.log',
  error_file: '/opt/mongoshake/logs/' + name + '.err.log',
});

module.exports = {
  apps: [
    mk('shake-example', 'example.conf'),
  ],
};
